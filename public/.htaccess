DirectoryIndex in/index.html index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # 1. WordPress Admin & Core (Never touch or reroute)
  # ----------------------------------------------------------------------
  RewriteRule ^(.*)wp-admin - [L]
  RewriteRule ^(.*)wp-login\.php - [L]
  RewriteRule ^(.*)wp-content - [L]
  RewriteRule ^(.*)wp-includes - [L]

  # ----------------------------------------------------------------------
  # 2. Serve real physical files directly
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------
  # 3. Bare Root (theaischool.co /) -> Serve India React App
  # ----------------------------------------------------------------------
  RewriteRule ^$ in/index.html [L]

  # ----------------------------------------------------------------------
  # 4. Directory trailing-slash / index.html resolution
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+[^/])$ $1/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.html -f
  RewriteRule ^(.*/)$ $1index.html [L]

  # ----------------------------------------------------------------------
  # 5. Regional SPA Client-Side Routing Fallbacks
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^in(/.*)?$ in/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^us(/.*)?$ us/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ph(/.*)?$ ph/index.html [L]

  # ----------------------------------------------------------------------
  # 6. WordPress Fallback of last resort
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
