{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/ph/layout,_N_T_/ph/blogs/layout,_N_T_/ph/blogs/page,_N_T_/ph/blogs"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/ph/blogs/__PAGE__",
    "/ph/blogs",
    "/ph",
    "/_index",
    "/_head"
  ]
}