DirectoryIndex out/in/index.html out/index.html index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # 1. PASSTHROUGH: WordPress Admin & Real Root Files (Do NOT Touch)
  # ----------------------------------------------------------------------
  RewriteRule ^(.*)wp-admin - [L]
  RewriteRule ^(.*)wp-login\.php - [L]
  RewriteRule ^(.*)wp-content - [L]
  RewriteRule ^(.*)wp-includes - [L]

  # If a real physical file exists at root, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------
  # 2. BARE ROOT (theaischool.co /) -> Serve India React App
  # ----------------------------------------------------------------------
  RewriteRule ^$ out/in/index.html [L]

  # ----------------------------------------------------------------------
  # 3. ROUTE TO COMPILED OUT/ DIRECTORY (Hostinger Git Deployment)
  # ----------------------------------------------------------------------
  # Static JS/CSS chunks
  RewriteCond %{DOCUMENT_ROOT}/out/_next/$1 -f
  RewriteRule ^_next/(.*)$ out/_next/$1 [L]

  # Root Assets & Images
  RewriteCond %{DOCUMENT_ROOT}/out/assets/$1 -f
  RewriteRule ^assets/(.*)$ out/assets/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/out/images/$1 -f
  RewriteRule ^images/(.*)$ out/images/$1 [L]

  # Regional Static Files (e.g. /in/assets/logo.png -> /out/in/assets/logo.png)
  RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -f
  RewriteRule ^(.*)$ out/$1 [L]

  # Regional Directories (e.g. /in/about-us/ -> /out/in/about-us/index.html)
  RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI}index.html -f
  RewriteRule ^(.*)/$ out/$1/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ out/$1/index.html [L]

  # ----------------------------------------------------------------------
  # 4. REGIONAL SPA FALLBACKS
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_URI} ^/in
  RewriteRule ^.*$ out/in/index.html [L]

  RewriteCond %{REQUEST_URI} ^/us
  RewriteRule ^.*$ out/us/index.html [L]

  RewriteCond %{REQUEST_URI} ^/ph
  RewriteRule ^.*$ out/ph/index.html [L]

  # ----------------------------------------------------------------------
  # 5. GLOBAL FALLBACK: WordPress
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
