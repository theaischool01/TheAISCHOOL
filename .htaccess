DirectoryIndex out/in/index.html out/index.html index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # 1. WordPress Admin & Core (Never touch or reroute)
  # ----------------------------------------------------------------------
  RewriteRule ^(.*)wp-admin - [L]
  RewriteRule ^(.*)wp-login\.php - [L]
  RewriteRule ^(.*)wp-content - [L]
  RewriteRule ^(.*)wp-includes - [L]

  # ----------------------------------------------------------------------
  # 2. Prevent loops if already pointing into out/
  # ----------------------------------------------------------------------
  RewriteRule ^out/ - [L]

  # ----------------------------------------------------------------------
  # 3. Bare Root (theaischool.co/) -> Serve India React App Directly
  # ----------------------------------------------------------------------
  RewriteRule ^$ out/in/index.html [L]

  # ----------------------------------------------------------------------
  # 4. Next.js Static JS/CSS Chunks & Assets (Direct Unconditional Rewrite)
  # ----------------------------------------------------------------------
  RewriteRule ^_next/(.*)$ out/_next/$1 [L]
  RewriteRule ^assets/(.*)$ out/assets/$1 [L]
  RewriteRule ^images/(.*)$ out/images/$1 [L]

  # ----------------------------------------------------------------------
  # 5. Regional Media & Assets
  # ----------------------------------------------------------------------
  RewriteRule ^in/assets/(.*)$ out/in/assets/$1 [L]
  RewriteRule ^in/images/(.*)$ out/in/images/$1 [L]
  RewriteRule ^in/mentors/(.*)$ out/in/mentors/$1 [L]
  RewriteRule ^us/assets/(.*)$ out/us/assets/$1 [L]
  RewriteRule ^ph/assets/(.*)$ out/ph/assets/$1 [L]

  # ----------------------------------------------------------------------
  # 6. Favicons
  # ----------------------------------------------------------------------
  RewriteRule ^favicon\.ico$ out/favicon.ico [L]
  RewriteRule ^icon\.png$ out/icon.png [L]
  RewriteRule ^in/favicon\.ico$ out/in/favicon.ico [L]
  RewriteRule ^us/favicon\.ico$ out/us/favicon.ico [L]
  RewriteRule ^ph/favicon\.ico$ out/ph/favicon.ico [L]

  # ----------------------------------------------------------------------
  # 7. Static Prerendered Regional HTML Pages
  # ----------------------------------------------------------------------
  RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -f
  RewriteRule ^(.*)$ out/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ out/$1/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI}index.html -f
  RewriteRule ^(.*)$ out/$1index.html [L]

  # ----------------------------------------------------------------------
  # 8. Regional SPA Client-Side Routing Fallbacks
  # ----------------------------------------------------------------------
  RewriteRule ^in(/.*)?$ out/in/index.html [L]
  RewriteRule ^us(/.*)?$ out/us/index.html [L]
  RewriteRule ^ph(/.*)?$ out/ph/index.html [L]

  # ----------------------------------------------------------------------
  # 9. WordPress Fallback (for any other root URLs)
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
